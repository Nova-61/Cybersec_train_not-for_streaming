# Скопируй этот файл в .env и подставь свои значения.
# .env НЕ должен попадать в git — он уже должен быть в .gitignore.

# Обязательно: минимум 32 символа, используется для подписи JWT в auth-сервисе
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters-long

# Опционально — есть дефолты в docker-compose.yml
DB_PASSWORD=password
RATE_LIMIT=100
