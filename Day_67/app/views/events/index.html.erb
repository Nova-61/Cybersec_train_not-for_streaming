<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Все события</h1>
  <%= link_to "+ Добавить событие", new_event_path, class: "btn btn-primary" %>
</div>

<% if @events.any? %>
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Уровень</th>
        <th>Источник</th>
        <th>Сообщение</th>
        <th>Когда</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |event| %>
        <tr>
          <td>
            <span class="badge bg-<%= level_badge_color(event.level) %>">
              <%= event.level %>
            </span>
          </td>
          <td><%= event.source %></td>
          <td><%= truncate(event.message, length: 60) %></td>
          <td><%= event.created_at.strftime("%d.%m.%Y %H:%M") %></td>
          <td><%= link_to "Подробнее", event_path(event), class: "btn btn-sm btn-outline-secondary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-info">Событий пока нет.</div>
<% end %>
