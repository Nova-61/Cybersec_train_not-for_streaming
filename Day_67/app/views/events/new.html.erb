<h1>Новое событие</h1>

<%= form_with model: @event, class: "mt-3" do |form| %>
  <% if @event.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @event.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :level, "Уровень", class: "form-label" %>
    <%= form.select :level, %w[INFO WARNING ERROR DEBUG CRITICAL], {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :source, "Источник", class: "form-label" %>
    <%= form.text_field :source, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :message, "Сообщение", class: "form-label" %>
    <%= form.text_area :message, class: "form-control", rows: 4 %>
  </div>

  <%= form.submit "Создать", class: "btn btn-primary" %>
  <%= link_to "Отмена", events_path, class: "btn btn-secondary" %>
<% end %>
