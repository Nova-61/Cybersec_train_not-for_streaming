<h1>Логи (последние 50)</h1>

<table border="1" cellpadding="6" cellspacing="0">
  <thead>
    <tr>
      <th>Время</th>
      <th>Уровень</th>
      <th>Сообщение</th>
      <th>Источник</th>
    </tr>
  </thead>
  <tbody>
    <% @events.each do |event| %>
      <tr>
        <td><%= event.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
        <td><%= event.level %></td>
        <td><%= event.message %></td>
        <td><%= event.source %></td>
      </tr>
    <% end %>
  </tbody>
</table>
