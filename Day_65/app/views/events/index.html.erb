<h1>Все события</h1>

<% if @events.any? %>
  <table border="1" cellpadding="6">
    <thead>
      <tr>
        <th>Уровень</th>
        <th>Источник</th>
        <th>Сообщение</th>
        <th>Когда</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |event| %>
        <tr>
          <td><%= event.level %></td>
          <td><%= event.source %></td>
          <td><%= truncate(event.message, length: 60) %></td>
          <td><%= event.created_at.strftime("%d.%m.%Y %H:%M") %></td>
          <td><%= link_to "Подробнее", event_path(event) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Событий пока нет.</p>
<% end %>

<p><%= link_to "Добавить событие", new_event_path %></p>
